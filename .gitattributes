# Default: autodetect text vs binary, force LF in the working tree
* text=auto eol=lf

# Rust sources and manifests always use LF
*.rs text eol=lf
*.toml text eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
fixtures/protocol/**/*.bin binary
fixtures/a2a/**/*.bin binary

# Generated bindings preserve generator formatting.
packages/Konclave.ProtocolContracts.TypeScript/src/generated/**/*.ts -whitespace

.github/workflows/*.lock.yml linguist-generated=true
