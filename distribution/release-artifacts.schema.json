{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konclave.example.com/schemas/release-artifacts.schema.json",
  "title": "Konclave release artifact contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "artifacts"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./release-artifacts.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "signatureStatus", "toolchains"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "channel": {
          "type": "string",
          "const": "prerelease"
        },
        "signatureStatus": {
          "type": "string",
          "const": "unsigned"
        },
        "toolchains": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rust",
            "node",
            "npm",
            "powershellMinimum",
            "syft",
            "syftLinuxAmd64Sha256"
          ],
          "properties": {
            "rust": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "node": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "npm": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "powershellMinimum": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            },
            "syft": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "syftLinuxAmd64Sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "target",
          "operatingSystem",
          "architecture",
          "archiveFormat",
          "fileName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": ["plugin", "client", "relay", "gateway", "container"]
          },
          "target": {
            "type": "string",
            "enum": [
              "x86_64-unknown-linux-gnu",
              "x86_64-pc-windows-msvc",
              "aarch64-apple-darwin",
              "x86_64-apple-darwin",
              "linux/amd64",
              "portable"
            ]
          },
          "operatingSystem": {
            "type": "string",
            "enum": ["linux", "windows", "macos", "any"]
          },
          "architecture": {
            "type": "string",
            "enum": ["x64", "arm64", "any"]
          },
          "archiveFormat": {
            "type": "string",
            "enum": ["tar.gz", "zip", "docker.tar"]
          },
          "fileName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
          },
          "rootDirectory": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "applicationRoot": {
            "type": "string",
            "pattern": "^apps/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "componentName": {
            "type": "string",
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
          },
          "provenanceInputs": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^apps/[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "container"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "required": ["image", "componentName", "applicationRoot", "provenanceInputs"]
            },
            "else": {
              "if": {
                "properties": {
                  "kind": {
                    "enum": ["client", "relay", "gateway"]
                  }
                },
                "required": ["kind"]
              },
              "then": {
                "required": ["rootDirectory"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "plugin"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "target": {
                  "const": "portable"
                },
                "operatingSystem": {
                  "const": "any"
                },
                "architecture": {
                  "const": "any"
                },
                "archiveFormat": {
                  "const": "zip"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": ["rootDirectory"]
                  },
                  {
                    "required": ["image"]
                  },
                  {
                    "required": ["applicationRoot"]
                  },
                  {
                    "required": ["componentName"]
                  },
                  {
                    "required": ["provenanceInputs"]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": ["client", "relay", "gateway", "container"]
                }
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "target": {
                  "enum": [
                    "x86_64-unknown-linux-gnu",
                    "x86_64-pc-windows-msvc",
                    "aarch64-apple-darwin",
                    "x86_64-apple-darwin",
                    "linux/amd64"
                  ]
                },
                "operatingSystem": {
                  "enum": ["linux", "windows", "macos"]
                },
                "architecture": {
                  "enum": ["x64", "arm64"]
                }
              }
            }
          }
        ]
      }
    }
  }
}
