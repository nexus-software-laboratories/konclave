      {
        "name": "Negotiated request delivery options, admission cutoff, receipt recovery and history-only observations",
        "status": "passed"
      },
      {
        "name": "Complete Rust workspace, no-default storage modes, security dependency policy, protocol fixtures and Node quality gates",
        "status": "passed"
      },
      {
        "name": "Pinned upstream A2A TCK profile and official Python SDK interoperability",
        "status": "passed"
      },
