{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Konclave protocol release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "release",
    "protocol",
    "storage",
    "dependencies",
    "fixtures",
    "conformance",
    "knownLimitations"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./protocol-release.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "status", "date"],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^protocol-v[0-9]+\\.[0-9]+\\.[0-9]+-[0-9A-Za-z.-]+$"
        },
        "status": {
          "type": "string",
          "const": "prerelease"
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protobufPackage",
        "transportEndpointMajor",
        "relayEnvelope",
        "application",
        "mls",
        "hardLimits"
      ],
      "properties": {
        "protobufPackage": { "type": "string", "const": "konclave.protocol.v1" },
        "transportEndpointMajor": { "type": "integer", "const": 1 },
        "relayEnvelope": { "type": "string", "const": "1.0" },
        "application": { "type": "string", "const": "1.0" },
        "mls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standard", "ciphersuite", "extensions"],
          "properties": {
            "standard": { "type": "string", "const": "RFC 9420" },
            "ciphersuite": {
              "type": "string",
              "const": "MLS_128_DHKEMX25519_AES128GCM_SHA256_Ed25519"
            },
            "extensions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["0xff00", "0xff01", "0xff02"]
              },
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true
            }
          }
        },
        "hardLimits": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daemonProfileSchema", "mlsSchemaOwnership"],
      "properties": {
        "daemonProfileSchema": { "type": "integer", "minimum": 1 },
        "mlsSchemaOwnership": { "type": "string", "minLength": 1 }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["securityCritical", "lockfiles"],
      "properties": {
        "securityCritical": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/dependency" }
        },
        "lockfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/fileHash" }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/fileHash" }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "pullRequests", "suites", "securityReview"],
      "properties": {
        "policy": { "type": "string", "const": "docs/development/conformance.md" },
        "pullRequests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "runId", "status"],
            "properties": {
              "number": { "type": "integer", "minimum": 1 },
              "runId": { "type": "integer", "minimum": 1 },
              "status": { "type": "string", "const": "passed" }
            }
          }
        },
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "const": "passed" }
            }
          }
        },
        "securityReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "independentThirdPartyAudit", "scope"],
          "properties": {
            "disposition": { "type": "string", "const": "approved" },
            "independentThirdPartyAudit": { "type": "boolean", "const": false },
            "scope": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "knownLimitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
