{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:konclave:schema:collaboration-policy-source:v2",
  "title": "Konclave collaboration policy source v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "konclave.dev/v2"
    },
    "kind": {
      "const": "CollaborationPolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/canonicalIdentifier",
          "maxLength": 128
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statements": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/statement"
          }
        },
        "requiredHarnessClaims": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/namespacedIdentifier"
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    }
  },
  "$defs": {
    "canonicalIdentifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:[./][a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)*$"
    },
    "namespacedIdentifier": {
      "allOf": [
        {
          "$ref": "#/$defs/canonicalIdentifier"
        },
        {
          "pattern": "[./]"
        }
      ],
      "maxLength": 256
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "action"],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonicalIdentifier",
          "maxLength": 128
        },
        "effect": {
          "enum": ["allow", "deny", "require_local_approval"]
        },
        "action": {
          "$ref": "#/$defs/namespacedIdentifier"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/namespacedIdentifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "optionalPositiveInteger": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMilliseconds": {
          "$ref": "#/$defs/optionalPositiveInteger"
        },
        "turns": {
          "$ref": "#/$defs/optionalPositiveInteger"
        },
        "tokens": {
          "$ref": "#/$defs/optionalPositiveInteger"
        },
        "concurrentRequests": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    }
  }
}
