{
  "$schema": "./genesis-delivery.schema.json",
  "schemaVersion": 1,
  "template": "secure-agent-communications-workspace",
  "defaultBranch": "main",
  "ciWorkflow": "CI",
  "requiredChecks": [
    "CI",
    "Container CI (community-relay)",
    "Daemon packaging (local-daemon)",
    "PR title",
    "Review policy"
  ],
  "draftValidation": {
    "hostedDefault": "subset",
    "pitcrewDefault": "full",
    "subsetJobs": [
      "lint"
    ]
  },
  "runnerProfiles": [
    {
      "id": "linux-x64-general-purpose",
      "source": "project",
      "labels": [
        "self-hosted",
        "linux",
        "x64",
        "general-purpose"
      ],
      "jobs": [
        "rust-build-test",
        "rust-lint",
        "node-build-and-test",
        "local-daemon-daemon-packaging"
      ]
    },
    {
      "id": "linux-x64-automation-control",
      "source": "project",
      "labels": [
        "linux",
        "x64",
        "automation-control"
      ],
      "jobs": [
        "source-policy",
        "validation-plan",
        "ci",
        "pr-base/base",
        "pr-title/title",
        "pr-review-policy/evaluate"
      ]
    },
    {
      "id": "linux-x64-image-builder",
      "source": "project",
      "labels": [
        "linux",
        "x64",
        "image-builder"
      ],
      "jobs": [
        "community-relay-container-ci"
      ]
    }
  ],
  "componentWorkflows": [],
  "pullRequestTitle": {
    "pattern": "^(feat|fix|docs|refactor|test|style|build|ci|chore|perf|revert)(\\([a-z0-9][a-z0-9._/-]*\\))?!?: .+$",
    "maxLength": 72
  },
  "squashMerge": {
    "method": "squash",
    "title": "PR_TITLE",
    "message": "PR_BODY"
  }
}
