      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/trusted-device-alias-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Trusted device alias conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/distribution-lifecycle-acceptance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
