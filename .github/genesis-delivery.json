{
  "$schema": "./genesis-delivery.schema.json",
  "schemaVersion": 1,
  "template": "secure-agent-communications-workspace",
  "defaultBranch": "main",
  "ciWorkflow": "CI",
  "requiredChecks": [
    "CI",
    "Workflow syntax",
    "A2A conformance",
    "A2A discovery conformance",
    "Adapter conformance",
    "Actions storage conformance",
    "Agent plugin conformance",
    "Authorization reload conformance",
    "Extension startup conformance",
    "Recipe conformance",
    "Authorization store conformance",
    "Client runtime config conformance",
    "Distribution lifecycle acceptance",
    "Generic client conformance",
    "Local delivery diagnostics conformance",
    "Installer lifecycle conformance",
    "Marketplace conformance",
    "Pairing rendezvous conformance",
    "Relay migration conformance",
    "Relay migration Windows conformance",
    "Short-code pairing conformance",
    "Trusted device alias conformance",
    "User presence conformance",
    "Container CI (a2a-gateway)",
    "Container CI (community-relay)",
    "Daemon packaging (local-daemon)",
    "Package validation",
    "PR title",
    "Release publication conformance",
    "Review policy"
  ],
  "draftValidation": {
    "hostedDefault": "ready-only",
    "pitcrewDefault": "ready-only",
    "subsetJobs": []
  },
  "runnerProfiles": [
    {
      "id": "ubuntu-latest-hosted",
      "source": "github-hosted",
      "labels": [
        "ubuntu-latest"
      ],
      "jobs": [
        "rust-build-test",
        "rust-lint",
        "node-build-and-test",
        "local-daemon-daemon-packaging",
        "source-policy",
        "validation-plan",
        "guidance-policy",
        "dependabot-validation",
        "ci",
        "workflow-syntax",
        "pr-base/base",
        "pr-title/title",
        "pr-review-policy/evaluate",
        "release-publication-conformance",
        "authorize-storage-cleanup",
        "a2a-conformance",
        "a2a-discovery-conformance",
        "adapter-conformance",
        "actions-storage-conformance",
        "agent-plugin-conformance",
        "authorization-reload-conformance",
        "extension-startup-conformance",
        "recipe-conformance",
        "resolve-package-scope",
        "package-plugin",
        "publish",
        "authorization-store-conformance",
        "client-runtime-config-conformance",
        "distribution-lifecycle-acceptance",
        "resolve-scope",
        "copilot-plugin-lifecycle",
        "native-installer-lifecycle",
        "service-failure-contract",
        "generic-client-conformance",
        "local-delivery-diagnostics-conformance",
        "resolve-installer-scope",
        "installer-lifecycle-conformance",
        "marketplace-conformance",
        "marketplace-materialization",
        "marketplace-client-lifecycle",
        "managed-marketplace-policy",
        "pairing-rendezvous-conformance",
        "relay-migration-conformance",
        "short-code-pairing-conformance",
        "trusted-device-alias-conformance",
        "user-presence-conformance",
        "community-relay-container-ci",
        "container-ci",
        "delete-run-artifacts",
        "prune-actions-caches"
      ]
    },
    {
      "id": "windows-latest-hosted",
      "source": "github-hosted",
      "labels": [
        "windows-latest"
      ],
      "jobs": [
        "relay-migration-windows-conformance"
      ]
    }
  ],
  "componentWorkflows": [
    {
      "source": "project",
      "path": ".github/workflows/workflow-syntax.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Workflow syntax"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/a2a-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "ready-only",
      "requiredChecks": [
        "A2A conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/a2a-discovery-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "A2A discovery conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/adapter-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "ready-only",
      "requiredChecks": [
        "Adapter conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/actions-storage-conformance.yml",
