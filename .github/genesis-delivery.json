{
  "$schema": "./genesis-delivery.schema.json",
  "schemaVersion": 1,
  "template": "secure-agent-communications-workspace",
  "defaultBranch": "main",
  "ciWorkflow": "CI",
  "requiredChecks": [
    "CI",
    "A2A conformance",
    "Adapter conformance",
    "Agent plugin conformance",
    "Authorization store conformance",
    "Client runtime config conformance",
    "Distribution lifecycle acceptance",
    "Generic client conformance",
    "Installer lifecycle conformance",
    "User presence conformance",
    "Container CI (a2a-gateway)",
    "Container CI (community-relay)",
    "Daemon packaging (local-daemon)",
    "Package validation",
    "PR title",
    "Release publication conformance",
    "Review policy"
  ],
  "draftValidation": {
    "hostedDefault": "ready-only",
    "pitcrewDefault": "ready-only",
    "subsetJobs": []
  },
  "runnerProfiles": [
    {
      "id": "ubuntu-latest-hosted",
      "source": "github-hosted",
      "labels": [
        "ubuntu-latest"
      ],
      "jobs": [
        "rust-build-test",
        "rust-lint",
        "node-build-and-test",
        "local-daemon-daemon-packaging",
        "source-policy",
        "validation-plan",
        "guidance-policy",
        "ci",
        "pr-base/base",
        "pr-title/title",
        "pr-review-policy/evaluate",
        "release-publication-conformance",
        "a2a-conformance",
        "adapter-conformance",
        "agent-plugin-conformance",
        "package-plugin",
        "publish",
        "authorization-store-conformance",
        "client-runtime-config-conformance",
        "distribution-lifecycle-acceptance",
        "resolve-scope",
        "copilot-plugin-lifecycle",
        "native-installer-lifecycle",
        "service-failure-contract",
        "generic-client-conformance",
        "installer-lifecycle-conformance",
        "user-presence-conformance",
        "community-relay-container-ci",
        "container-ci",
        "delete-run-artifacts"
      ]
    }
  ],
  "componentWorkflows": [
    {
      "source": "project",
      "path": ".github/workflows/a2a-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "ready-only",
      "requiredChecks": [
        "A2A conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/adapter-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "ready-only",
      "requiredChecks": [
        "Adapter conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/agent-plugin-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Agent plugin conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/authorization-store-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Authorization store conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/client-runtime-config-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Client runtime config conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/distribution-lifecycle-acceptance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Distribution lifecycle acceptance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/generic-client-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Generic client conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/installer-lifecycle-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Installer lifecycle conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/user-presence-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "User presence conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/package-validation.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "ready-only",
      "requiredChecks": [
        "Package validation"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/release-publication-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Release publication conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/publish-prerelease.yml",
      "roles": [
        "repository-automation"
      ],
      "draftBehavior": "not-applicable",
      "requiredChecks": []
    },
    {
      "source": "project",
      "path": ".github/workflows/package-artifact-cleanup.yml",
      "roles": [
        "repository-automation"
      ],
      "draftBehavior": "not-applicable",
      "requiredChecks": []
    }
  ],
  "pullRequestTitle": {
    "pattern": "^(feat|fix|docs|refactor|test|style|build|ci|chore|perf|revert)(\\([a-z0-9][a-z0-9._/-]*\\))?!?: .+$",
    "maxLength": 72
  },
  "squashMerge": {
    "method": "squash",
    "title": "PR_TITLE",
    "message": "PR_BODY"
  }
}
