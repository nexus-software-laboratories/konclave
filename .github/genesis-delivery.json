      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Authorization reload conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/client-runtime-config-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
        "Client runtime config conformance"
      ]
    },
    {
      "source": "project",
      "path": ".github/workflows/relay-migration-conformance.yml",
      "roles": [
        "merge-gate"
      ],
      "draftBehavior": "full",
      "requiredChecks": [
