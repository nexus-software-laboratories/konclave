    {
      "classification": "profile-exclusion",
      "requirements": [
        "CORE-CANCEL-002",
        "CORE-CANCEL-003"
      ],
      "rationale": "CancelTask is intentionally unsupported because Konclave cannot retract an already delivered directed request.",
      "evidence": [
        "docs/adr/adr-0013-a2a-edge-interoperability.md",
        "docs/development/a2a-reference-gateway.md"
      ],
      "expectedErrors": {
        "CORE-CANCEL-002": [
          "Expected error code 409 (TaskNotCancelableError), got 400"
        ],
        "CORE-CANCEL-003": [
          "Expected error code 404 (TaskNotFoundError), got 400"
        ]
      }
    },
    {
      "classification": "profile-exclusion",
      "requirements": [
        "CORE-MULTI-004"
      ],
      "rationale": "Task-addressed follow-up messages belong to the deferred multi-turn mapping and are rejected before side effects.",
      "evidence": [
        "docs/adr/adr-0013-a2a-edge-interoperability.md",
        "docs/protocol/a2a-compatibility.md"
      ],
      "expectedErrors": {
        "CORE-MULTI-004": [
          "Expected error code 404 (TaskNotFoundError), got 400"
        ]
      }
    },
    {
      "classification": "upstream-suite-state-collision",
      "requirements": [
        "CORE-EXECUTION-MODE-001",
        "CORE-EXECUTION-MODE-002",
        "CORE-MULTI-001a",
        "CORE-MULTI-003"
      ],
      "rationale": "The full TCK reuses one messageId with changed text or configuration, which correctly conflicts with Konclave durable idempotency. Each requirement passes against a fresh SUT and store.",
      "evidence": [
        "a2aproject/a2a-tck@263b9cfaf16a554bdfb166a7ba5b67716e946349:backlog/archive/tasks/task-22 - Wire-TCK-tests-to-use-scenario-specific-messageId-prefixes.md"
      ],
      "expectedErrors": {
        "CORE-EXECUTION-MODE-001": [
          "Operation failed: [409] A2A task identity conflicts with existing state"
        ],
        "CORE-EXECUTION-MODE-002": [
          "Operation failed: [409] A2A task identity conflicts with existing state"
        ],
        "CORE-MULTI-001a": [
          "Operation failed: [409] A2A task identity conflicts with existing state"
        ],
        "CORE-MULTI-003": [
          "Operation failed: [409] A2A task identity conflicts with existing state"
        ]
      }
    },
    {
      "classification": "upstream-validator-defect",
      "requirements": [
        "CORE-MULTI-002a",
        "CORE-SEND-003"
      ],
      "rationale": "The requirement definitions omit expected_error, so the generic TCK validator records the required protocol error as a failure.",
      "evidence": [
        "https://github.com/a2aproject/a2a-tck/issues/202"
      ],
      "expectedErrors": {
        "CORE-MULTI-002a": [
          "Operation failed: [404] A2A task or route was not found"
        ],
        "CORE-SEND-003": [
          "Operation failed: [400] A2A content type is not supported"
        ]
      }
    },
    {
      "classification": "tck-protocol-version-mismatch",
      "requirements": [
        "HTTP_JSON-ERR-001",
        "HTTP_JSON-SVC-001"
      ],
      "rationale": "The pinned TCK embeds A2A v1.0.0 and expects application/json, while Konclave pins v1.0.1, whose HTTP+JSON binding recommends application/a2a+json for success and error responses.",
      "evidence": [
        "https://github.com/a2aproject/a2a-tck/issues/240",
        "https://github.com/a2aproject/A2A/blob/v1.0.1/docs/specification.md"
      ],
      "expectedErrors": {
        "HTTP_JSON-ERR-001": [
          "Error Content-Type must be application/json, got: 'application/a2a+json'",
          "Error Content-Type must be application/json, got: 'application/a2a+json'"
        ],
        "HTTP_JSON-SVC-001": [
          "Expected Content-Type application/json, got: 'application/a2a+json'"
        ]
      }
    },
    {
      "classification": "mixed-known-gap",
      "requirements": [
        "HTTP_JSON-STATUS-001"
      ],
      "rationale": "This aggregate combines the deliberate CancelTask exclusion, v1.0.0 error-status expectations superseded by v1.0.1, and a raw TCK probe that concatenates a canonical trailing-slash interface URL with a leading-slash path.",
      "evidence": [
        "https://github.com/a2aproject/a2a-tck/issues/240",
        "a2aproject/a2a-tck@263b9cfaf16a554bdfb166a7ba5b67716e946349:tests/compatibility/http_json/test_http_status.py"
      ],
      "expectedErrors": {
        "HTTP_JSON-STATUS-001": [
          "CancelTask on non-existent task should return 404 (TaskNotFoundError) or 409 (TaskNotCancelableError), got 400",
          "Status code mismatch: expected ContentTypeNotSupportedError (415), got 404 (could be: TaskNotFoundError, MethodNotFoundError)"
        ]
      }
    }
