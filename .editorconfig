# Reassert the node tag's LF/UTF-8 root convention after the rust tag, and add the
# Rust indent override the node tag does not declare. Composed Node guests receive
# their own EditorConfig islands at each apps/extensions mount.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
